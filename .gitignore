# ── QuestaSim / ModelSim build artifacts ─────────────────────────────────────
work/
transcript
vsim.wlf
*.wlf
*.mti
*.vstf

# ── Simulation output files ───────────────────────────────────────────────────
dump.vcd
*.vcd

# ── Coverage databases (binary, regenerated by run_all_uvm_tests.bat) ─────────
uvm_test_logs/*.ucdb

# ── Simulation logs and all generated files in uvm_test_logs ─────────────────
uvm_test_logs/*.log
uvm_test_logs/*.data
uvm_test_logs/*.db
uvm_test_logs/*.txt
uvm_test_logs/*.js
uvm_test_logs/*.json
uvm_test_logs/*.png
uvm_test_logs/*.wlf

# ── Generated HTML reports (regenerated by Python scripts) ───────────────────
# Keep pipeline.html (static, hand-crafted) — ignore all others
html_reports/*.html
!html_reports/pipeline.html

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
scripts/__pycache__/
*.pyc
*.pyo

# ── Editor / OS artifacts ─────────────────────────────────────────────────────
.vscode/settings.json
*.swp
*.swo
Thumbs.db
.DS_Store
